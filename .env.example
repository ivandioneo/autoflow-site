# Copy to .env.local for local development.
# Set these in Cloudflare Pages → Settings → Environment Variables for production.
# NEVER commit .env.local to git.

# AutoFlow API base URL
VITE_API_URL=https://api.autoflow.ivanit.work

# AutoFlow Dashboard URL
VITE_DASHBOARD_URL=https://dashboard.autoflow.ivanit.work

# Cloudflare Turnstile site key (public — safe to expose in client code)
# Get from: Cloudflare Dashboard → Turnstile → Add site
VITE_TURNSTILE_SITE_KEY=
